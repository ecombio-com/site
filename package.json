{
  "name": "site",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:hydrogen:bicyclebio": "pnpm --filter @site/hydrogen run dev:bicyclebio",
    "dev:hydrogen:scooterbio": "pnpm --filter @site/hydrogen run dev:scooterbio",
    "dev:hydrogen:skaterbio": "pnpm --filter @site/hydrogen run dev:skaterbio",
    "dev:headless": "pnpm --filter @site/headless run dev"
  },
  "devDependencies": {
    "portless": "0.18.1",
    "turbo": "^2.11.13"
  }
}
