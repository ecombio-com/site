# --- Auth ---
# openssl rand -base64 32   (must be 32+ chars)
AUTH_SECRET=

# --- Shopify Admin API (server-only, never prefix with NEXT_PUBLIC_) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2026-10
# Dev Dashboard app (client credentials grant; tokens auto-refresh):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ONLY if you have a legacy custom app created before 2026-01-01 (overrides the two above):
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Upstash Redis (Vercel Marketplace sets KV_REST_API_* automatically) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
AUTH_EMAIL_FROM="Your Store <login@yourdomain.com>"
